---
import type { ArchiveFilterLabels } from '../../i18n/ui';

interface Props {
  /** Id of the grid this control set filters and sorts. */
  targetId: string;
  groups: string[];
  labels: ArchiveFilterLabels;
}

const { targetId, groups, labels } = Astro.props;

const sortOptions = [
  { value: 'newest', label: labels.sortOptions.newest },
  { value: 'oldest', label: labels.sortOptions.oldest },
  { value: 'rating', label: labels.sortOptions.rating },
  { value: 'title', label: labels.sortOptions.title },
];
---

<section class="archive-filters glass-card" data-archive-filter-root data-target={targetId}>
  <label>
    <span>{labels.search}</span>
    <input type="search" placeholder={labels.searchPlaceholder} data-archive-search />
  </label>

  <label>
    <span>{labels.filter}</span>
    <select data-archive-group>
      <option value="">{labels.all}</option>
      {groups.map((group) => <option value={group}>{group}</option>)}
    </select>
  </label>

  <label>
    <span>{labels.sort}</span>
    <select data-archive-sort>
      {sortOptions.map((option) => <option value={option.value}>{option.label}</option>)}
    </select>
  </label>

  <label class="filter-toggle">
    <input type="checkbox" data-archive-favorite />
    <span>{labels.favorite}</span>
  </label>
</section>

<script>
  const normalizeArchiveValue = (value: string | null | undefined) =>
    String(value || '').trim().toLocaleLowerCase();

  const initializeArchiveFilters = (root: HTMLElement) => {
    const targetId = root.dataset.target;
    const list = targetId ? document.getElementById(targetId) : null;
    if (!list) return;

    const items = Array.from(list.querySelectorAll<HTMLElement>('[data-archive-item]'));
    const searchInput = root.querySelector<HTMLInputElement>('[data-archive-search]');
    const groupSelect = root.querySelector<HTMLSelectElement>('[data-archive-group]');
    const favoriteInput = root.querySelector<HTMLInputElement>('[data-archive-favorite]');
    const sortSelect = root.querySelector<HTMLSelectElement>('[data-archive-sort]');
    const emptyState = document.querySelector<HTMLElement>(`[data-archive-empty="${targetId}"]`);

    const sortItems = (entries: HTMLElement[], sortValue: string) => {
      return [...entries].sort((a, b) => {
        if (sortValue === 'oldest') {
          return Number(a.dataset.year || 0) - Number(b.dataset.year || 0);
        }

        if (sortValue === 'rating') {
          return Number(b.dataset.rating || 0) - Number(a.dataset.rating || 0);
        }

        if (sortValue === 'title') {
          return String(a.dataset.title || '').localeCompare(String(b.dataset.title || ''));
        }

        return Number(b.dataset.year || 0) - Number(a.dataset.year || 0);
      });
    };

    const update = () => {
      const query = normalizeArchiveValue(searchInput?.value);
      const group = normalizeArchiveValue(groupSelect?.value);
      const favoriteOnly = Boolean(favoriteInput?.checked);
      const sortValue = sortSelect?.value || 'newest';

      const visibleItems = items.filter((item) => {
        const searchText = normalizeArchiveValue(item.dataset.search);
        const groups = normalizeArchiveValue(item.dataset.groups).split('|').filter(Boolean);
        const matchesSearch = !query || searchText.includes(query);
        const matchesGroup = !group || groups.includes(group);
        const matchesFavorite = !favoriteOnly || item.dataset.favorite === 'true';

        return matchesSearch && matchesGroup && matchesFavorite;
      });

      const sortedItems = sortItems(visibleItems, sortValue);
      const visibleSet = new Set(sortedItems);

      items.forEach((item) => {
        item.hidden = !visibleSet.has(item);
      });

      sortedItems.forEach((item) => list.appendChild(item));

      if (emptyState) {
        emptyState.hidden = sortedItems.length > 0;
      }
    };

    [searchInput, groupSelect, favoriteInput, sortSelect].forEach((control) => {
      control?.addEventListener('input', update);
      control?.addEventListener('change', update);
    });

    update();
  };

  const initializeAllArchiveFilters = () => {
    document
      .querySelectorAll<HTMLElement>('[data-archive-filter-root]')
      .forEach(initializeArchiveFilters);
  };

  initializeAllArchiveFilters();
  document.addEventListener('astro:page-load', initializeAllArchiveFilters);
</script>
