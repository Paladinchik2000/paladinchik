---
import CoverImage from './CoverImage.astro';

interface Props {
  title: string;
  description?: string;
  href: string;
  eyebrow?: string | number;
  cover?: ImageMetadata;
  coverType?: string;
  fallbackMeta?: Array<string | number | false | undefined>;
  meta?: Array<string | number | false | undefined>;
  chips?: string[];
  actionLabel?: string;
  noCoverLabel?: string;
  filterText?: string;
  filterGroups?: string[];
  filterFavorite?: boolean;
  sortTitle?: string;
  sortYear?: number;
  sortRating?: number;
}

const {
  title,
  description,
  href,
  eyebrow,
  cover,
  coverType = 'ARCHIVE',
  fallbackMeta = [],
  meta = [],
  chips = [],
  actionLabel = 'Read note',
  noCoverLabel = 'No cover',
  filterText,
  filterGroups = [],
  filterFavorite = false,
  sortTitle = title,
  sortYear,
  sortRating,
} = Astro.props;

const visibleMeta = meta.filter(Boolean);
const visibleFallbackMeta = fallbackMeta.filter(Boolean).slice(0, 2);
---

<a
  class="archive-card archive-entry-card glass-card"
  href={href}
  data-archive-item
  data-search={filterText}
  data-groups={filterGroups.join('|')}
  data-favorite={String(filterFavorite)}
  data-title={sortTitle}
  data-year={sortYear}
  data-rating={sortRating}
>
  <div class:list={['archive-cover', { 'has-cover': cover }]} aria-hidden="true">
    {
      cover ? (
        <CoverImage src={cover} preset="card" />
      ) : (
        <div class="fallback-cover-content">
          <span class="fallback-cover-type">{coverType}</span>
          <strong>{title}</strong>
          {visibleFallbackMeta.length > 0 ? <em>{visibleFallbackMeta.join(' / ')}</em> : <em>{noCoverLabel}</em>}
        </div>
      )
    }
  </div>
  <div class="archive-card-body">
    {eyebrow && <span class="card-eyebrow">{eyebrow}</span>}
    <h3>{title}</h3>
    {
      visibleMeta.length > 0 && (
        <div class="meta-row">
          {visibleMeta.map((item) => <span>{item}</span>)}
        </div>
      )
    }
    {
      chips.length > 0 && (
        <div class="chip-list">
          {chips.map((chip) => <span class="chip">{chip}</span>)}
        </div>
      )
    }
    {description && <p>{description}</p>}
    <span class="card-link">{actionLabel}</span>
  </div>
</a>
