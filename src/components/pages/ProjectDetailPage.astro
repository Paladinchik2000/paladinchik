---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../layout/BaseLayout.astro';
import type { Locale } from '../../i18n/ui';
import CoverImage from '../ui/CoverImage.astro';
import { format, getContentSlug, getTranslations, localizePath } from '../../i18n/utils';
import { createBreadcrumbSchema, createCreativeWorkSchema } from '../../lib/structuredData';

interface Props {
  lang: Locale;
  project: CollectionEntry<'projects'>;
}

const { lang, project } = Astro.props;
const t = getTranslations(lang);
const copy = t.projects;

const { Content } = await render(project);
const cardCover = project.data.cover;
const coverImage = project.data.heroCover ?? cardCover;
const dateRange = [project.data.startDate, project.data.endDate].filter(Boolean).join(' - ');
const chips = [...(project.data.stack ?? []), ...(project.data.tags ?? [])];
const highlights = project.data.highlights ?? [];

const canonicalPath = localizePath(`/projects/${getContentSlug(project)}`, lang);
const breadcrumbs = createBreadcrumbSchema([
  { name: t.common.breadcrumbHome, url: localizePath('/', lang) },
  { name: copy.title, url: localizePath('/projects', lang) },
  { name: project.data.title, url: canonicalPath },
]);
const projectSchema = createCreativeWorkSchema({
  title: project.data.title,
  description: project.data.description,
  url: canonicalPath,
  image: (cardCover ?? coverImage)?.src,
  datePublished: project.data.startDate,
  dateModified: project.data.endDate,
  lang,
});
---

<BaseLayout
  title={project.data.title}
  description={project.data.description ?? format(t.common.noteFallback.project, { title: project.data.title })}
  lang={lang}
  canonicalPath={canonicalPath}
  image={cardCover ?? coverImage}
  type="article"
  jsonLd={[projectSchema, breadcrumbs]}
>
  <a class="back-link" href={localizePath('/projects', lang)}>{t.common.back.projects}</a>

  <div class:list={['detail-cover', { 'has-cover': coverImage }]} aria-hidden="true">
    {
      coverImage ? (
        <CoverImage src={coverImage} preset="detail" eager />
      ) : (
        <div class="fallback-cover-content detail-fallback-cover-content">
          <span class="fallback-cover-type">PROJECT</span>
          <strong>{project.data.title}</strong>
          <em>{[project.data.status, project.data.year].filter(Boolean).join(' / ')}</em>
        </div>
      )
    }
  </div>

  <section class="page-hero detail-hero">
    <p class="eyebrow">{copy.title}</p>
    <h1>{project.data.title}</h1>
    <div class="detail-meta">
      {project.data.status && <span>{project.data.status}</span>}
      {project.data.year && <span>{project.data.year}</span>}
      {dateRange && <span>{dateRange}</span>}
      {project.data.role && <span>{project.data.role}</span>}
    </div>
    {project.data.description && <p>{project.data.description}</p>}
    <div class="external-links">
      {project.data.url && <a class="button button-primary" href={project.data.url}>{t.common.liveSite}</a>}
      {project.data.github && <a class="button button-secondary" href={project.data.github}>{t.common.github}</a>}
    </div>
  </section>

  <section class="project-detail-grid">
    <article class="text-panel glass-card">
      <h2>{copy.stackTitle}</h2>
      <div class="chip-list">
        {chips.map((chip) => <span class="chip">{chip}</span>)}
      </div>
    </article>
    <article class="text-panel glass-card">
      <h2>{copy.highlightsTitle}</h2>
      {
        highlights.length > 0 ? (
          <ul class="clean-list">
            {highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
        ) : (
          <p>{copy.noHighlights}</p>
        )
      }
    </article>
  </section>

  <article class="prose text-panel glass-card">
    <Content />
  </article>
</BaseLayout>
