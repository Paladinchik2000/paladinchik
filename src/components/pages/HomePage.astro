---
import BaseLayout from '../layout/BaseLayout.astro';
import Card from '../ui/Card.astro';
import BrandLogo from '../ui/BrandLogo.astro';
import { sectionKeys, type Locale } from '../../i18n/ui';
import { getTranslations, localizePath } from '../../i18n/utils';
import { createPersonSchema, createWebSiteSchema } from '../../lib/structuredData';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const sections = sectionKeys.map((key) => ({
  title: t.pages[key],
  description: t.home.sections[key].description,
  eyebrow: t.home.sections[key].eyebrow,
  href: localizePath(`/${key}`, lang),
}));
---

<BaseLayout
  title={t.home.title}
  description={t.home.description}
  lang={lang}
  canonicalPath={localizePath('/', lang)}
  jsonLd={[createWebSiteSchema(lang), createPersonSchema()]}
>
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-content">
      <BrandLogo variant="hero" />
      <p class="eyebrow">{t.common.personalArchive}</p>
      <h1 id="home-title">{t.home.title}</h1>
      <p>{t.home.description}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={localizePath('/about', lang)}>{t.home.enterArchive}</a>
        <a class="button button-secondary" href={localizePath('/cv', lang)}>{t.home.viewCv}</a>
      </div>
    </div>
  </section>

  <section class="section-block archive-index-section" aria-labelledby="archive-sections">
    <div class="section-heading">
      <p class="eyebrow">{t.common.index}</p>
      <h2 id="archive-sections">{t.home.sectionsTitle}</h2>
      <p>{t.home.sectionsDescription}</p>
    </div>
    <div class="section-grid">
      {sections.map((section) => <Card {...section} actionLabel={t.common.open} />)}
    </div>
  </section>
</BaseLayout>
