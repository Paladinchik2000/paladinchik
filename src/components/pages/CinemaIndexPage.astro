---
import { getCollection } from 'astro:content';
import BaseLayout from '../layout/BaseLayout.astro';
import ArchiveCard from '../ui/ArchiveCard.astro';
import ArchiveFilters from '../ui/ArchiveFilters.astro';
import type { Locale } from '../../i18n/ui';
import { getContentSlug, getTranslations, localizePath } from '../../i18n/utils';
import { genreSlugs, getGenreLabel } from '../../lib/genres';
import { createBreadcrumbSchema, createCollectionPageSchema } from '../../lib/structuredData';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const copy = t.cinema;

const movies = (await getCollection('movies'))
  .filter((movie) => movie.data.lang === lang)
  .sort((a, b) => b.data.year - a.data.year);

const genres = [...new Set(movies.flatMap((movie) => movie.data.genres ?? []))].sort((a, b) =>
  a.localeCompare(b),
);

const genreLinks = genreSlugs
  .map((slug) => {
    const label = getGenreLabel(slug, lang);
    return { slug, label, count: movies.filter((m) => (m.data.genres ?? []).includes(label)).length };
  })
  .filter((genre) => genre.count > 0)
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const canonicalPath = localizePath('/cinema', lang);
const gridId = 'cinema-archive';
const breadcrumbs = createBreadcrumbSchema([
  { name: t.common.breadcrumbHome, url: localizePath('/', lang) },
  { name: copy.title, url: canonicalPath },
]);
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath={canonicalPath}
  jsonLd={[
    createCollectionPageSchema({
      title: copy.title,
      description: copy.description,
      url: canonicalPath,
      lang,
    }),
    breadcrumbs,
  ]}
>
  <section class="page-hero">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.title}</h1>
    <p>{copy.description}</p>
  </section>

  <nav class="genre-links" aria-label={copy.genresHeading}>
    <p class="eyebrow">{copy.genresHeading}</p>
    <div class="chip-list">
      {
        genreLinks.map((genre) => (
          <a class="chip chip-link" href={localizePath(`/cinema/genre/${genre.slug}`, lang)}>
            {genre.label} <span>{genre.count}</span>
          </a>
        ))
      }
    </div>
  </nav>

  <ArchiveFilters targetId={gridId} groups={genres} labels={copy.filters} />

  <section id={gridId} class="page-section archive-grid" aria-label={copy.ariaLabel}>
    {
      movies.map((movie) => (
        <ArchiveCard
          title={movie.data.title}
          description={movie.data.description}
          href={localizePath(`/cinema/${getContentSlug(movie)}`, lang)}
          eyebrow={movie.data.year}
          cover={movie.data.cover}
          coverShape="poster"
          coverType="FILM"
          fallbackMeta={[movie.data.year, movie.data.rating && `${movie.data.rating}/10`]}
          meta={[movie.data.rating && `${movie.data.rating}/10`, movie.data.favorite && t.common.favorite]}
          chips={movie.data.genres}
          actionLabel={t.common.readNote}
          noCoverLabel={t.common.noCover}
          filterText={[
            movie.data.title,
            movie.data.year,
            movie.data.description,
            ...(movie.data.genres ?? []),
          ]
            .filter(Boolean)
            .join(' ')}
          filterGroups={movie.data.genres}
          filterFavorite={movie.data.favorite}
          sortTitle={movie.data.title}
          sortYear={movie.data.year}
          sortRating={movie.data.rating}
        />
      ))
    }
  </section>

  <div class="archive-empty-state glass-card" data-archive-empty={gridId} hidden>
    <p>{copy.filters.empty}</p>
  </div>
</BaseLayout>
