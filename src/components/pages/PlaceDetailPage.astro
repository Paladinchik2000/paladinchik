---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../layout/BaseLayout.astro';
import type { Locale } from '../../i18n/ui';
import CoverImage from '../ui/CoverImage.astro';
import { format, getContentSlug, getTranslations, localizePath } from '../../i18n/utils';
import { createBreadcrumbSchema, createCreativeWorkSchema } from '../../lib/structuredData';

interface Props {
  lang: Locale;
  place: CollectionEntry<'places'>;
}

const { lang, place } = Astro.props;
const t = getTranslations(lang);
const copy = t.places;

const { Content } = await render(place);
const cardCover = place.data.cover;
const coverImage = place.data.heroCover ?? cardCover;
const gallery = place.data.gallery ?? [];

const canonicalPath = localizePath(`/places/${getContentSlug(place)}`, lang);
const breadcrumbs = createBreadcrumbSchema([
  { name: t.common.breadcrumbHome, url: localizePath('/', lang) },
  { name: copy.title, url: localizePath('/places', lang) },
  { name: place.data.title, url: canonicalPath },
]);
const placeSchema = createCreativeWorkSchema({
  title: place.data.title,
  description: place.data.description,
  url: canonicalPath,
  image: (cardCover ?? coverImage)?.src,
  datePublished: place.data.visitedAt,
  lang,
});
---

<BaseLayout
  title={place.data.title}
  description={place.data.description ?? format(t.common.noteFallback.place, { title: place.data.title })}
  lang={lang}
  canonicalPath={canonicalPath}
  image={cardCover ?? coverImage}
  type="article"
  jsonLd={[placeSchema, breadcrumbs]}
>
  <a class="back-link" href={localizePath('/places', lang)}>{t.common.back.places}</a>

  <div class:list={['detail-cover', { 'has-cover': coverImage }]} aria-hidden="true">
    {
      coverImage ? (
        <CoverImage src={coverImage} preset="detail" eager />
      ) : (
        <div class="fallback-cover-content detail-fallback-cover-content">
          <span class="fallback-cover-type">PLACE</span>
          <strong>{place.data.title}</strong>
          <em>{[place.data.city, place.data.country].filter(Boolean).join(' / ')}</em>
        </div>
      )
    }
  </div>

  <section class="page-hero detail-hero">
    <p class="eyebrow">{copy.title}</p>
    <h1>{place.data.title}</h1>
    <div class="detail-meta">
      <span>{place.data.country}</span>
      {place.data.city && <span>{place.data.city}</span>}
      {place.data.visitedAt && <span>{place.data.visitedAt}</span>}
    </div>
    {place.data.tags && (
      <div class="chip-list">
        {place.data.tags.map((tag) => <span class="chip">{tag}</span>)}
      </div>
    )}
    {place.data.description && <p>{place.data.description}</p>}
  </section>

  <article class="prose text-panel glass-card">
    <Content />
  </article>

  <section class="page-section" aria-labelledby="place-gallery">
    <div class="section-heading">
      <p class="eyebrow">{copy.photosEyebrow}</p>
      <h2 id="place-gallery">{copy.galleryTitle}</h2>
    </div>
    {
      gallery.length > 0 ? (
        <div class="gallery-grid">
          {gallery.map((image, index) => (
            <div class="gallery-tile">
              <CoverImage
                src={image}
                preset="gallery"
                alt={format(copy.galleryImageAlt, { title: place.data.title, index: index + 1 })}
              />
            </div>
          ))}
        </div>
      ) : (
        <div class="text-panel glass-card gallery-empty">
          <p>{copy.galleryEmpty}</p>
        </div>
      )
    }
  </section>
</BaseLayout>
