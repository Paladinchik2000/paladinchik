---
import type { Locale } from '../../i18n/ui';
import { siteConfig } from '../../data/site';
import { getTranslations, localizePath } from '../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);

const year = new Date().getFullYear();

const footerLinks = [
  { href: localizePath('/now', lang), label: t.nav.now },
  { href: localizePath('/about', lang), label: t.nav.about },
  { href: localizePath('/cv', lang), label: t.nav.cv },
];

const socialLinks = [
  { href: localizePath('/rss.xml', lang), label: 'RSS' },
  { href: siteConfig.social.github, label: 'GitHub' },
  { href: siteConfig.social.youtube, label: 'YouTube' },
  { href: siteConfig.social.telegram, label: 'Telegram' },
  { href: siteConfig.social.email, label: 'Email' },
];
---

<footer class="site-footer">
  <nav class="site-footer-nav" aria-label={t.footer.navLabel}>
    {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>

  <nav class="site-footer-social" aria-label={t.footer.socialLabel}>
    {
      socialLinks.map((link) => (
        <a href={link.href} rel="me noopener">
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="site-footer-meta">
    <p>© {year} {siteConfig.author}. {t.common.footerArchive}</p>
    <p>{t.common.builtWithAstro}</p>
  </div>
</footer>

<style>
  .site-footer-nav,
  .site-footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    justify-content: center;
  }

  .site-footer-nav a,
  .site-footer-social a {
    color: inherit;
    text-decoration: none;
    opacity: 0.72;
    transition: opacity 160ms ease;
  }

  .site-footer-nav a:hover,
  .site-footer-nav a:focus-visible,
  .site-footer-social a:hover,
  .site-footer-social a:focus-visible {
    opacity: 1;
  }

  .site-footer-social a {
    font-size: 0.92em;
  }

  .site-footer-meta {
    display: grid;
    gap: 0.15rem;
  }
</style>
