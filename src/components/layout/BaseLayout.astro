---
import Header from './Header.astro';
import Footer from './Footer.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { Locale } from '../../i18n/ui';
import { siteConfig } from '../../data/site';
import { getAlternateLocaleUrl } from '../../i18n/utils';
import '../../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  canonicalPath?: string;
  image?: string;
  type?: string;
}

const {
  title,
  description,
  lang = 'en',
  canonicalPath = Astro.url.pathname,
  image,
  type = 'website',
} = Astro.props;
const siteName = siteConfig.siteName;
const pageTitle = title === siteName ? siteConfig.siteTitle : `${title} | ${siteName}`;
const normalizedPath = canonicalPath === '/' ? '/' : canonicalPath.replace(/\/$/, '');
const canonicalUrl = new URL(normalizedPath, siteConfig.siteUrl).toString();
const imageCandidate = typeof image === 'string' && image.length > 0 ? image : siteConfig.defaultSocialImage;
const publicAssetExists = (assetPath: string) => {
  if (!assetPath.startsWith('/')) return false;
  return existsSync(join(process.cwd(), 'public', assetPath.slice(1)));
};
const resolvedImage = imageCandidate.startsWith('http') || publicAssetExists(imageCandidate)
  ? imageCandidate
  : siteConfig.defaultSocialImage;
const imageUrl = resolvedImage.startsWith('http') ? resolvedImage : new URL(resolvedImage, siteConfig.siteUrl).toString();
const ogLocale = lang === 'ru' ? 'ru_RU' : 'en_US';
const alternateLang = lang === 'ru' ? 'en' : 'ru';
const alternatePath = getAlternateLocaleUrl(normalizedPath, lang);
const alternateUrl = new URL(alternatePath, siteConfig.siteUrl).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050607" />
    <meta name="theme-color" content="#b7f000" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#050607" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonicalUrl : alternateUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" href="/images/brand/logo-p.png" />
    <link rel="shortcut icon" href="/images/brand/logo-p.png" />
    <link rel="apple-touch-icon" href="/images/brand/logo-p.png" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <Header lang={lang} />
      <main id="main-content" class="site-main">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
  </body>
</html>
