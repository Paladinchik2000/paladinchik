---
import { getImage } from 'astro:assets';
import Header from './Header.astro';
import Footer from './Footer.astro';
import JsonLd from '../seo/JsonLd.astro';
import PrismaticShaderBackground from '../ui/PrismaticShaderBackground.astro';
import { locales, type Locale } from '../../i18n/ui';
import { siteConfig } from '../../data/site';
import { getAlternateLocaleUrl, getTranslations } from '../../i18n/utils';
import { getFallbackSocialImage } from '../../lib/assets';
import { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH } from '../../lib/images';
import '../../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  canonicalPath?: string;
  /** Entry artwork; cropped to the Open Graph size. Falls back to the brand image. */
  image?: ImageMetadata;
  type?: string;
  jsonLd?: unknown;
}

const {
  title,
  description,
  lang = 'en',
  canonicalPath = Astro.url.pathname,
  image,
  type = 'website',
  jsonLd,
} = Astro.props;
const t = getTranslations(lang);
const siteName = siteConfig.siteName;
const pageTitle = title === siteName ? siteConfig.siteTitle : `${title} | ${siteName}`;
const normalizedPath = canonicalPath === '/' ? '/' : canonicalPath.replace(/\/$/, '');
// The animated background is reserved for the landing page; see
// PrismaticShaderBackground for why.
const isHome = normalizedPath === '/' || locales.some((locale) => normalizedPath === `/${locale}`);
const canonicalUrl = new URL(normalizedPath, siteConfig.siteUrl).toString();
// Entry artwork is re-encoded to a fixed 1200x630 JPEG: social crawlers want a
// predictable aspect ratio and do not reliably handle avif/webp.
const ogImage = image
  ? await getImage({
      src: image,
      width: OG_IMAGE_WIDTH,
      height: OG_IMAGE_HEIGHT,
      fit: 'cover',
      format: 'jpeg',
    })
  : undefined;
const fallbackImage = ogImage ? undefined : getFallbackSocialImage();
const resolvedImage = ogImage?.src ?? fallbackImage;
const imageUrl = resolvedImage ? new URL(resolvedImage, siteConfig.siteUrl).toString() : undefined;
const ogLocale = lang === 'ru' ? 'ru_RU' : 'en_US';
const alternateLang = lang === 'ru' ? 'en' : 'ru';
const alternatePath = getAlternateLocaleUrl(normalizedPath, lang);
const alternateUrl = new URL(alternatePath, siteConfig.siteUrl).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050607" />
    <meta name="theme-color" content="#7ddfff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#050607" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Inter+Tight:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonicalUrl : alternateUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content={title} />}
    {ogImage && <meta property="og:image:type" content="image/jpeg" />}
    {ogImage && <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />}
    {ogImage && <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />}
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:image:alt" content={title} />}
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" href="/images/brand/logo-p.png" />
    <link rel="shortcut icon" href="/images/brand/logo-p.png" />
    <link rel="apple-touch-icon" href="/images/brand/logo-p.png" />
    <JsonLd data={jsonLd} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <PrismaticShaderBackground animated={isHome} />
    <a class="skip-link" href="#main-content">{t.common.skipToContent}</a>
    <div class="site-shell">
      <Header lang={lang} />
      <main id="main-content" class="site-main">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
  </body>
</html>
