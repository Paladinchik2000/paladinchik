---
import LanguageSwitcher from '../ui/LanguageSwitcher.astro';
import BrandLogo from '../ui/BrandLogo.astro';
import type { Locale } from '../../i18n/ui';
import {
  getAlternateLocaleUrl,
  getTranslations,
  localizePath,
  stripLocaleFromPath,
} from '../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);

const navItems = [
  { href: '/', label: t.nav.home },
  { href: '/about', label: t.nav.about },
  { href: '/cinema', label: t.nav.cinema },
  { href: '/library', label: t.nav.library },
  { href: '/places', label: t.nav.places },
  { href: '/projects', label: t.nav.projects },
];

const currentPath = stripLocaleFromPath(Astro.url.pathname);
const currentUrl = localizePath(currentPath, lang);
const alternateUrl = getAlternateLocaleUrl(Astro.url.pathname, lang);
const cvIsActive = currentPath === '/cv';
---

<header class="site-header" data-site-header>
  <a class="brand-mark" href={localizePath('/', lang)} aria-label={t.common.homeLinkLabel}>
    <BrandLogo variant="nav" withText />
  </a>

  <button class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
    <span class="mobile-nav-toggle-lines" aria-hidden="true"></span>
    <span class="sr-only">{t.common.menu}</span>
  </button>

  <nav id="site-nav" class="site-nav" aria-label={t.common.primaryNavLabel}>
    {
      navItems.map((item) => {
        const itemPath = item.href.replace(/\/$/, '') || '/';
        const isActive = currentPath === itemPath;

        return (
          <a href={localizePath(item.href, lang)} aria-current={isActive ? 'page' : undefined}>
            {item.label}
          </a>
        );
      })
    }
  </nav>

  <div class="header-actions">
    <a
      class="header-cv-link"
      href={localizePath('/cv', lang)}
      aria-current={cvIsActive ? 'page' : undefined}
    >
      {t.nav.cv}
    </a>
    <LanguageSwitcher
      lang={lang}
      currentUrl={currentUrl}
      alternateUrl={alternateUrl}
      label={t.common.languageSwitcherLabel}
    />
  </div>
</header>

<script>
  const initializeMobileNavigation = () => {
    document.querySelectorAll('[data-site-header]').forEach((header) => {
      if (header.getAttribute('data-mobile-nav-ready') === 'true') return;
      const toggle = header.querySelector('.mobile-nav-toggle');
      const nav = header.querySelector('.site-nav');
      if (!(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;
      header.setAttribute('data-mobile-nav-ready', 'true');

      const closeMenu = () => {
        header.removeAttribute('data-menu-open');
        toggle.setAttribute('aria-expanded', 'false');
      };

      toggle.addEventListener('click', () => {
        const isOpen = header.getAttribute('data-menu-open') === 'true';
        if (isOpen) {
          closeMenu();
        } else {
          header.setAttribute('data-menu-open', 'true');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });

      nav.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenu();
      });
    });
  };

  initializeMobileNavigation();
  document.addEventListener('astro:page-load', initializeMobileNavigation);
</script>
