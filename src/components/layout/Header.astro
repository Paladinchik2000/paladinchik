---
import LanguageSwitcher from '../ui/LanguageSwitcher.astro';
import BrandLogo from '../ui/BrandLogo.astro';
import type { Locale } from '../../i18n/ui';
import { getAlternateLocaleUrl, getLocalizedUrl, stripLocaleFromPath, useTranslations } from '../../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const navItems = [
  { href: '/', label: t('nav.home') },
  { href: '/about', label: t('nav.about') },
  { href: '/cinema', label: t('nav.cinema') },
  { href: '/library', label: t('nav.library') },
  { href: '/places', label: t('nav.places') },
  { href: '/projects', label: t('nav.projects') },
];

const currentPath = stripLocaleFromPath(Astro.url.pathname);
const currentUrl = getLocalizedUrl(currentPath, lang);
const alternateUrl = getAlternateLocaleUrl(Astro.url.pathname, lang);
const cvIsActive = currentPath === '/cv';
---

<header class="site-header" data-site-header>
  <a class="brand-mark" href={getLocalizedUrl('/', lang)} aria-label="Nikita Paladi home">
    <BrandLogo variant="nav" withText />
  </a>

  <button class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
    <span class="mobile-nav-toggle-lines" aria-hidden="true"></span>
    <span class="sr-only">Menu</span>
  </button>

  <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
    {
      navItems.map((item) => {
        const itemPath = item.href.replace(/\/$/, '') || '/';
        const isActive = currentPath === itemPath;

        return (
          <a href={getLocalizedUrl(item.href, lang)} aria-current={isActive ? 'page' : undefined}>
            {item.label}
          </a>
        );
      })
    }
  </nav>

  <div class="header-actions">
    <a class="header-cv-link" href={getLocalizedUrl('/cv', lang)} aria-current={cvIsActive ? 'page' : undefined}>
      {t('nav.cv')}
    </a>
    <LanguageSwitcher lang={lang} currentUrl={currentUrl} alternateUrl={alternateUrl} />
  </div>
</header>

<script>
  const initializeMobileNavigation = () => {
    document.querySelectorAll('[data-site-header]').forEach((header) => {
      if (header.getAttribute('data-mobile-nav-ready') === 'true') return;
      const toggle = header.querySelector('.mobile-nav-toggle');
      const nav = header.querySelector('.site-nav');
      if (!(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;
      header.setAttribute('data-mobile-nav-ready', 'true');

      const closeMenu = () => {
        header.removeAttribute('data-menu-open');
        toggle.setAttribute('aria-expanded', 'false');
      };

      toggle.addEventListener('click', () => {
        const isOpen = header.getAttribute('data-menu-open') === 'true';
        header.toggleAttribute('data-menu-open', !isOpen);
        if (!isOpen) {
          header.setAttribute('data-menu-open', 'true');
        }
        toggle.setAttribute('aria-expanded', String(!isOpen));
      });

      nav.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenu();
      });
    });
  };

  initializeMobileNavigation();
  document.addEventListener('astro:page-load', initializeMobileNavigation);
</script>
