---
interface Props {
  data?: unknown;
}

const { data } = Astro.props;

const cleanJsonLd = (value: unknown): unknown => {
  if (value === undefined || value === null) return undefined;

  if (Array.isArray(value)) {
    const cleanedArray = value.map(cleanJsonLd).filter((item) => item !== undefined);
    return cleanedArray.length > 0 ? cleanedArray : undefined;
  }

  if (typeof value === 'object') {
    const cleanedEntries = Object.entries(value as Record<string, unknown>)
      .map(([key, item]) => [key, cleanJsonLd(item)] as const)
      .filter(([, item]) => item !== undefined);

    return cleanedEntries.length > 0 ? Object.fromEntries(cleanedEntries) : undefined;
  }

  return value;
};

const cleanedData = cleanJsonLd(data);
const serialized = cleanedData
  ? JSON.stringify(cleanedData)
      .replace(/</g, '\\u003c')
      .replace(/>/g, '\\u003e')
      .replace(/&/g, '\\u0026')
      .replace(/\u2028/g, '\\u2028')
      .replace(/\u2029/g, '\\u2029')
  : undefined;
---

{serialized && <script type="application/ld+json" set:html={serialized} />}
