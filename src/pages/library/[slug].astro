---
import { getCollection } from 'astro:content';
import BookDetailPage from '../../components/pages/BookDetailPage.astro';
import { getContentSlug } from '../../i18n/utils';

export async function getStaticPaths() {
  const books = (await getCollection('books')).filter((book) => book.data.lang === 'en');

  return books.map((book) => ({
    params: { slug: getContentSlug(book) },
    props: { book },
  }));
}

const { book } = Astro.props;
---

<BookDetailPage lang="en" book={book} />
