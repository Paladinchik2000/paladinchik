---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ArchiveCard from '../../components/ui/ArchiveCard.astro';
import ArchiveFilters from '../../components/ui/ArchiveFilters.astro';
import { getContentSlug, useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
const books = (await getCollection('books')).filter((book) => book.data.lang === lang).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0),
);

const getEntrySlug = (entry) => getContentSlug(entry);
const genres = [...new Set(books.flatMap((book) => book.data.genres ?? []))].sort((a, b) => a.localeCompare(b));
const sortOptions = [
  { value: 'newest', label: 'Newest first' },
  { value: 'oldest', label: 'Oldest first' },
  { value: 'rating', label: 'Highest rated' },
  { value: 'title', label: 'Title A-Z' },
];
---

<BaseLayout
  title="Library"
  description="Books, notes, ideas, and short reading reflections from the personal archive."
  lang={lang}
  canonicalPath="/library"
>
  <section class="page-hero">
    <p class="eyebrow">Reading</p>
    <h1>Library</h1>
    <p>Books, notes, ideas, and short reflections.</p>
  </section>

  <ArchiveFilters
    targetId="library-archive"
    genres={genres}
    searchLabel="Search"
    searchPlaceholder="Search books, authors, notes, or genres"
    filterLabel="Genre"
    allLabel="All genres"
    favoriteLabel="Favorites only"
    sortLabel="Sort"
    sortOptions={sortOptions}
  />

  <section id="library-archive" class="page-section placeholder-grid" aria-label="Library entries">
    {
      books.map((book) => (
        <ArchiveCard
          title={book.data.title}
          description={book.data.description}
          href={`/library/${getEntrySlug(book)}`}
          eyebrow={book.data.author}
          cover={book.data.cover}
          meta={[book.data.year, book.data.rating && `${book.data.rating}/10`, book.data.favorite && t('common.favorite')]}
          chips={book.data.genres}
          actionLabel={t('common.readNote')}
          noCoverLabel={t('common.noCover')}
          filterText={[book.data.title, book.data.author, book.data.description, ...(book.data.genres ?? [])].filter(Boolean).join(' ')}
          filterGroups={book.data.genres}
          filterFavorite={book.data.favorite}
          sortTitle={book.data.title}
          sortYear={book.data.year}
          sortRating={book.data.rating}
        />
      ))
    }
  </section>
  <div class="archive-empty-state glass-card" data-archive-empty="library-archive" hidden>
    <p>No entries match your filters.</p>
  </div>
</BaseLayout>
