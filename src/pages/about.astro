---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { createBreadcrumbSchema } from '../lib/structuredData';

const lang = 'en';
const breadcrumbs = createBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about' },
]);
---

<BaseLayout
  title="About"
  description="About Nikita Paladi, the personal archive, and the interests behind it."
  lang={lang}
  canonicalPath="/about"
  jsonLd={breadcrumbs}
>
  <section class="page-hero">
    <p class="eyebrow">Personal Archive</p>
    <h1>About</h1>
    <p>
      I am Nikita Paladi, a beginner programmer and prototype creator interested
      in web development, AI tools, social media, and creative projects.
    </p>
  </section>

  <section class="page-section content-list" aria-label="About sections">
    <article class="text-panel glass-card">
      <h2>Background</h2>
      <p>
        This website is my personal archive: a place for projects, films, books,
        places, and ideas that I want to keep organized and return to over time.
      </p>
    </article>
    <article class="text-panel glass-card">
      <h2>Interests</h2>
      <p>
        I like building small web experiments, testing AI-assisted workflows,
        thinking about social media, and shaping rough ideas into usable prototypes.
        Away from the screen, I enjoy table tennis, cycling, and mountain hiking.
      </p>
    </article>
    <article class="text-panel glass-card">
      <h2>Current focus</h2>
      <p>
        I am learning by making: improving this archive, practicing front-end
        structure, and collecting the projects and references that help me see
        my direction more clearly.
      </p>
    </article>
  </section>
</BaseLayout>
