---
import { getCollection } from 'astro:content';
import ProjectDetailPage from '../../../components/pages/ProjectDetailPage.astro';
import { getContentSlug } from '../../../i18n/utils';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((project) => project.data.lang === 'ru');

  return projects.map((project) => ({
    params: { slug: getContentSlug(project) },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<ProjectDetailPage lang="ru" project={project} />
