---
import { getCollection } from 'astro:content';
import MovieDetailPage from '../../../components/pages/MovieDetailPage.astro';
import { getContentSlug } from '../../../i18n/utils';

export async function getStaticPaths() {
  const movies = (await getCollection('movies')).filter((movie) => movie.data.lang === 'ru');

  return movies.map((movie) => ({
    params: { slug: getContentSlug(movie) },
    props: { movie },
  }));
}

const { movie } = Astro.props;
---

<MovieDetailPage lang="ru" movie={movie} />
