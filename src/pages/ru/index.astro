---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Card from '../../components/ui/Card.astro';
import BrandLogo from '../../components/ui/BrandLogo.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'ru';
const t = useTranslations(lang);

const sections = [
  {
    title: t('pages.about'),
    description: 'Коротко о моем фоне, интересах и текущем направлении.',
    href: '/ru/about',
    eyebrow: 'Профиль',
  },
  {
    title: t('pages.cinema'),
    description: 'Фильмы, которые повлияли на вкус, настроение и взгляд на истории.',
    href: '/ru/cinema',
    eyebrow: 'Отзывы',
  },
  {
    title: t('pages.library'),
    description: 'Книги, заметки, идеи и короткие размышления, которые хочется сохранить.',
    href: '/ru/library',
    eyebrow: 'Чтение',
  },
  {
    title: t('pages.places'),
    description: 'Города и места из поездок, собранные в личную карту.',
    href: '/ru/places',
    eyebrow: 'Путешествия',
  },
  {
    title: t('pages.projects'),
    description: 'Избранные работы, эксперименты и проекты, которые я развиваю.',
    href: '/ru/projects',
    eyebrow: 'Работа',
  },
  {
    title: t('pages.cv'),
    description: 'Краткий обзор опыта, проектов, навыков и текущего фокуса.',
    href: '/ru/cv',
    eyebrow: 'CV',
  },
];
---

<BaseLayout title={t('home.title')} description={t('home.description')} lang={lang} canonicalPath="/ru">
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-content">
      <BrandLogo variant="hero" />
      <p class="eyebrow">{t('common.personalArchive')}</p>
      <h1 id="home-title">{t('home.title')}</h1>
      <p>{t('home.description')}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/ru/about">{t('home.enterArchive')}</a>
        <a class="button button-secondary" href="/ru/cv">{t('home.viewCv')}</a>
      </div>
    </div>
  </section>

  <section class="section-block archive-index-section" aria-labelledby="archive-sections">
    <div class="section-heading">
      <p class="eyebrow">{t('common.index')}</p>
      <h2 id="archive-sections">{t('home.sectionsTitle')}</h2>
      <p>{t('home.sectionsDescription')}</p>
    </div>
    <div class="section-grid">
      {sections.map((section) => <Card {...section} />)}
    </div>
  </section>
</BaseLayout>
