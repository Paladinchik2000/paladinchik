---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import { getContentSlug, useTranslations } from '../../../i18n/utils';
import { createBookReviewSchema, createBreadcrumbSchema } from '../../../lib/structuredData';

const lang = 'ru';
const t = useTranslations(lang);

export async function getStaticPaths() {
  const books = (await getCollection('books')).filter((book) => book.data.lang === 'ru');

  return books.map((book) => ({
    params: { slug: getContentSlug(book) },
    props: { book },
  }));
}

const { book } = Astro.props;
const { Content } = await render(book);
const coverStyle = book.data.cover ? `--cover-image: url("${book.data.cover}")` : undefined;
const slug = getContentSlug(book);
const canonicalPath = `/ru/library/${slug}`;
const breadcrumbs = createBreadcrumbSchema([
  { name: 'Главная', url: '/ru' },
  { name: 'Библиотека', url: '/ru/library' },
  { name: book.data.title, url: canonicalPath },
]);
const reviewSchema = createBookReviewSchema({
  title: book.data.title,
  description: book.data.description,
  url: canonicalPath,
  image: book.data.cover,
  bookAuthor: book.data.author,
  year: book.data.year,
  rating: book.data.rating,
  genres: book.data.genres,
  lang,
});
---

<BaseLayout
  title={book.data.title}
  description={book.data.description ?? `${book.data.title}: заметка о книге.`}
  lang={lang}
  canonicalPath={canonicalPath}
  image={book.data.cover}
  type="article"
  jsonLd={[reviewSchema, breadcrumbs]}
>
  <a class="back-link" href="/ru/library">{t('common.back.library')}</a>

  <div class:list={['detail-cover', { 'has-cover': book.data.cover }]} style={coverStyle} aria-hidden="true">
    {!book.data.cover && <span>{t('common.noCover')}</span>}
  </div>

  <section class="page-hero detail-hero">
    <p class="eyebrow">Библиотека</p>
    <h1>{book.data.title}</h1>
    <div class="detail-meta">
      <span>{book.data.author}</span>
      {book.data.year && <span>{book.data.year}</span>}
      {book.data.rating && <span>{book.data.rating}/10</span>}
    </div>
    {book.data.genres && (
      <div class="chip-list">
        {book.data.genres.map((genre) => <span class="chip">{genre}</span>)}
      </div>
    )}
    {book.data.description && <p>{book.data.description}</p>}
  </section>

  <article class="prose text-panel glass-card">
    <Content />
  </article>
</BaseLayout>
