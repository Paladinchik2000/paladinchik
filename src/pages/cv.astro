---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/layout/BaseLayout.astro';
import { siteConfig } from '../data/site';
import { getContentSlug } from '../i18n/utils';
import { createBreadcrumbSchema } from '../lib/structuredData';

const lang = 'en';
const selectedProjects = (await getCollection('projects'))
  .filter((project) => project.data.lang === lang && project.data.featured)
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const breadcrumbs = createBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'CV', url: '/cv' },
]);
---

<BaseLayout
  title="CV"
  description="Personal archive, creative projects, product experiments, and web development."
  lang={lang}
  canonicalPath="/cv"
  jsonLd={breadcrumbs}
>
  <section class="page-hero cv-hero">
    <p class="eyebrow">CV</p>
    <h1>Nikita Paladi</h1>
    <p>Personal archive, creative projects, product experiments, and web development.</p>
    <div class="page-actions">
      <a class="button button-primary" href="/files/cv.pdf">Download CV</a>
      <a class="button button-secondary" href="/projects">View Projects</a>
    </div>
    <p class="subtle-note">CV PDF is being prepared.</p>
  </section>

  <section class="cv-grid" aria-label="CV sections">
    <article class="text-panel glass-card cv-panel-wide">
      <h2>Profile</h2>
      <p>
        A concise overview of my current direction: web development, AI tools,
        social media, creative projects, and practical prototype work. I am a
        beginner programmer, so this CV focuses on what I am building, learning,
        and documenting honestly.
      </p>
    </article>

    <article class="text-panel glass-card">
      <h2>Focus Areas</h2>
      <ul class="clean-list">
        <li>Personal knowledge archives and content systems</li>
        <li>Web interfaces, AI-assisted workflows, and prototype structure</li>
        <li>Creative projects, social media ideas, and personal documentation</li>
      </ul>
    </article>

    <article class="text-panel glass-card">
      <h2>Skills</h2>
      <div class="chip-list">
        {['Astro', 'MDX', 'TypeScript', 'CSS', 'Content modeling', 'Interface design', 'Editing'].map((skill) => (
          <span class="chip">{skill}</span>
        ))}
      </div>
    </article>

    <article class="text-panel glass-card cv-panel-wide">
      <h2>Selected Projects</h2>
      <div class="cv-project-list">
        {selectedProjects.map((project) => (
          <a href={`/projects/${getContentSlug(project)}`}>
            <span>{project.data.year}</span>
            <strong>{project.data.title}</strong>
            <em>{project.data.description}</em>
          </a>
        ))}
      </div>
    </article>

    <article class="text-panel glass-card">
      <h2>Experience / Timeline</h2>
      <ul class="timeline-list">
        <li>
          <span>2026</span>
          Building the bilingual personal archive and improving its content structure.
        </li>
        <li>
          <span>2025</span>
          Learning through small prototypes, interface ideas, and practical web experiments.
        </li>
      </ul>
    </article>

    <article class="text-panel glass-card">
      <h2>Contact</h2>
      <p>
        For contact, write to <a href={siteConfig.social.email}>paladi.nikita2000@gmail.com</a>.
      </p>
    </article>
  </section>
</BaseLayout>
