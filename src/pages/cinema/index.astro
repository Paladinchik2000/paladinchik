---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ArchiveCard from '../../components/ui/ArchiveCard.astro';
import ArchiveFilters from '../../components/ui/ArchiveFilters.astro';
import { getContentSlug, useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
const movies = (await getCollection('movies')).filter((movie) => movie.data.lang === lang).sort(
  (a, b) => b.data.year - a.data.year,
);

const getEntrySlug = (entry) => getContentSlug(entry);
const genres = [...new Set(movies.flatMap((movie) => movie.data.genres ?? []))].sort((a, b) => a.localeCompare(b));
const sortOptions = [
  { value: 'newest', label: 'Newest first' },
  { value: 'oldest', label: 'Oldest first' },
  { value: 'rating', label: 'Highest rated' },
  { value: 'title', label: 'Title A-Z' },
];
---

<BaseLayout
  title="Cinema"
  description="Films watched, remembered, questioned, or returned to."
  lang={lang}
>
  <section class="page-hero">
    <p class="eyebrow">Reviews</p>
    <h1>Cinema</h1>
    <p>Films I watched, remembered, questioned, or returned to.</p>
  </section>

  <ArchiveFilters
    targetId="cinema-archive"
    genres={genres}
    searchLabel="Search"
    searchPlaceholder="Search films, notes, or genres"
    filterLabel="Genre"
    allLabel="All genres"
    favoriteLabel="Favorites only"
    sortLabel="Sort"
    sortOptions={sortOptions}
  />

  <section id="cinema-archive" class="page-section placeholder-grid" aria-label="Cinema entries">
    {
      movies.map((movie) => (
        <ArchiveCard
          title={movie.data.title}
          description={movie.data.description}
          href={`/cinema/${getEntrySlug(movie)}`}
          eyebrow={movie.data.year}
          cover={movie.data.cover}
          meta={[movie.data.rating && `${movie.data.rating}/10`, movie.data.favorite && t('common.favorite')]}
          chips={movie.data.genres}
          actionLabel={t('common.readNote')}
          noCoverLabel={t('common.noCover')}
          filterText={[movie.data.title, movie.data.description, ...(movie.data.genres ?? [])].filter(Boolean).join(' ')}
          filterGroups={movie.data.genres}
          filterFavorite={movie.data.favorite}
          sortTitle={movie.data.title}
          sortYear={movie.data.year}
          sortRating={movie.data.rating}
        />
      ))
    }
  </section>
  <div class="archive-empty-state glass-card" data-archive-empty="cinema-archive" hidden>
    <p>No entries match your filters.</p>
  </div>
</BaseLayout>
