---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ArchiveCard from '../../components/ui/ArchiveCard.astro';
import PlacesMap from '../../components/places/PlacesMap.astro';
import { getContentSlug, useTranslations } from '../../i18n/utils';
import { createBreadcrumbSchema, createCollectionPageSchema } from '../../lib/structuredData';

const lang = 'en';
const t = useTranslations(lang);
const places = (await getCollection('places')).filter((place) => place.data.lang === lang).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const getEntrySlug = (entry) => getContentSlug(entry);
const hasValidCoordinates = (coordinates) =>
  Array.isArray(coordinates)
  && coordinates.length === 2
  && coordinates.every((coordinate) => Number.isFinite(Number(coordinate)));
const mapPlaces = places
  .filter((place) => hasValidCoordinates(place.data.coordinates))
  .map((place) => ({
    title: place.data.title,
    location: [place.data.city, place.data.country].filter(Boolean).join(', '),
    description: place.data.description,
    href: `/places/${getEntrySlug(place)}`,
    coordinates: place.data.coordinates,
    mapZoom: place.data.mapZoom,
  }));
const pageDescription = 'A personal map of cities and places I have visited, with notes, photos, and impressions collected along the way.';
const breadcrumbs = createBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Places', url: '/places' },
]);
---

<BaseLayout
  title="Places"
  description={pageDescription}
  lang={lang}
  canonicalPath="/places"
  jsonLd={[
    createCollectionPageSchema({ title: 'Places', description: pageDescription, url: '/places', lang }),
    breadcrumbs,
  ]}
>
  <section class="page-hero">
    <p class="eyebrow">Travel</p>
    <h1>Places</h1>
    <p>A personal map of cities and places I have visited, with notes, photos, and impressions collected along the way.</p>
  </section>

  <PlacesMap places={mapPlaces} lang={lang} />

  <section class="page-section archive-grid" aria-label="Places entries">
    {
      places.map((place) => (
        <ArchiveCard
          title={place.data.title}
          description={place.data.description}
          href={`/places/${getEntrySlug(place)}`}
          eyebrow={place.data.country}
          cover={place.data.cover}
          coverType="PLACE"
          fallbackMeta={[place.data.city, place.data.country]}
          meta={[place.data.city, place.data.visitedAt]}
          chips={place.data.tags}
          actionLabel={t('common.readNote')}
          noCoverLabel={t('common.noCover')}
        />
      ))
    }
  </section>
</BaseLayout>
