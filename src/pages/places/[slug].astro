---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { getContentSlug, useTranslations } from '../../i18n/utils';
import { getExistingPublicImage, getExistingPublicImages } from '../../lib/assets';
import { createBreadcrumbSchema, createCreativeWorkSchema } from '../../lib/structuredData';

const lang = 'en';
const t = useTranslations(lang);

export async function getStaticPaths() {
  const places = (await getCollection('places')).filter((place) => place.data.lang === 'en');

  return places.map((place) => ({
    params: { slug: getContentSlug(place) },
    props: { place },
  }));
}

const { place } = Astro.props;
const { Content } = await render(place);
const coverImage = getExistingPublicImage(place.data.cover);
const coverStyle = coverImage ? `--cover-image: url("${coverImage}")` : undefined;
const gallery = getExistingPublicImages(place.data.gallery ?? []);
const galleryTitle = 'Gallery';
const galleryEmptyText = 'This place is currently saved as a text note without a separate gallery.';
const slug = getContentSlug(place);
const canonicalPath = `/places/${slug}`;
const breadcrumbs = createBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Places', url: '/places' },
  { name: place.data.title, url: canonicalPath },
]);
const placeSchema = createCreativeWorkSchema({
  title: place.data.title,
  description: place.data.description,
  url: canonicalPath,
  image: coverImage,
  datePublished: place.data.visitedAt,
  lang,
});
---

<BaseLayout
  title={place.data.title}
  description={place.data.description ?? `${place.data.title} place note.`}
  lang={lang}
  canonicalPath={canonicalPath}
  image={coverImage}
  type="article"
  jsonLd={[placeSchema, breadcrumbs]}
>
  <a class="back-link" href="/places">{t('common.back.places')}</a>

  <div class:list={['detail-cover', { 'has-cover': coverImage }]} style={coverStyle} aria-hidden="true">
    {!coverImage && (
      <div class="fallback-cover-content detail-fallback-cover-content">
        <span class="fallback-cover-type">PLACE</span>
        <strong>{place.data.title}</strong>
        <em>{[place.data.city, place.data.country].filter(Boolean).join(' / ')}</em>
      </div>
    )}
  </div>

  <section class="page-hero detail-hero">
    <p class="eyebrow">Places</p>
    <h1>{place.data.title}</h1>
    <div class="detail-meta">
      <span>{place.data.country}</span>
      {place.data.city && <span>{place.data.city}</span>}
      {place.data.visitedAt && <span>{place.data.visitedAt}</span>}
    </div>
    {place.data.tags && (
      <div class="chip-list">
        {place.data.tags.map((tag) => <span class="chip">{tag}</span>)}
      </div>
    )}
    {place.data.description && <p>{place.data.description}</p>}
  </section>

  <article class="prose text-panel glass-card">
    <Content />
  </article>

  <section class="page-section" aria-labelledby="place-gallery">
    <div class="section-heading">
      <p class="eyebrow">Photos</p>
      <h2 id="place-gallery">{galleryTitle}</h2>
    </div>
    {
      gallery.length > 0 ? (
        <div class="gallery-grid">
          {gallery.map((image, index) => (
            <div
              class="gallery-tile"
              style={`--gallery-image: url("${image}")`}
              aria-label={`${place.data.title} gallery image ${index + 1}`}
            />
          ))}
        </div>
      ) : (
        <div class="text-panel glass-card gallery-empty">
          <p>{galleryEmptyText}</p>
        </div>
      )
    }
  </section>
</BaseLayout>
