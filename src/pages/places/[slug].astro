---
import { getCollection } from 'astro:content';
import PlaceDetailPage from '../../components/pages/PlaceDetailPage.astro';
import { getContentSlug } from '../../i18n/utils';

export async function getStaticPaths() {
  const places = (await getCollection('places')).filter((place) => place.data.lang === 'en');

  return places.map((place) => ({
    params: { slug: getContentSlug(place) },
    props: { place },
  }));
}

const { place } = Astro.props;
---

<PlaceDetailPage lang="en" place={place} />
